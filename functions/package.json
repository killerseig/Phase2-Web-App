{
  "name": "functions",
  "description": "Cloud Functions for phase2 app",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "preview:daily-log-email": "npm run build && node scripts/preview-daily-log-email.cjs",
    "preview:shop-order-email": "npm run build && node scripts/preview-shop-order-email.cjs",
    "preview:timecard-email": "npm run build && node scripts/preview-timecard-email.cjs",
    "smoke:daily-log-email": "npm run build && node scripts/smoke-daily-log-email.cjs",
    "smoke:shop-order-email": "npm run build && node scripts/smoke-shop-order-email.cjs",
    "smoke:timecard-email": "npm run build && node scripts/smoke-timecard-email.cjs"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.5",
    "axios": "^1.6.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.1.6"
  }
}
