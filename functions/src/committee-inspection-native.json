      "id": "committee-11",
      "kind": "textarea",
      "label": "Site Office: (secure, posters, notices, first aid kit, trauma bag, eye wash, cord test kit, fire extinguisher signed, spill kit)",
      "required": false,
      "options": []
    },
    {
      "id": "committee-12",
      "kind": "textarea",
      "label": "Housekeeping: (material stacked and orderly, cleanup decent, waste disposal, fuel and solvent storage, Toilets, Parking lot, site signage and restricted access zones maintained and current)",
      "required": false,
      "options": []
    },
    {
      "id": "committee-13",
      "kind": "textarea",
      "label": "PPE: (hard hats, helmets, eye protection, ear protection, gloves, boots, face shields, respirators, sleeves, extra properly stored)",
      "required": false,
      "options": []
    },
    {
      "id": "committee-14",
      "kind": "textarea",
      "label": "Ladders: (clean, used as designed, appropriate size, 4-1 rule, extend 3 ‘past landings, tied off securely)",
      "required": false,
      "options": []
    },
    {
      "id": "committee-15",
      "kind": "textarea",
      "label": "Electrical: (cord check done, no light gauge or garbage cords, no illegal plug ends, cords hung, GFCI’s as needed, colors in order green purple red yellow)",
      "required": false,
      "options": []
    },
    {
      "id": "committee-16",
      "kind": "textarea",
      "label": "Stilts, Walkups: (maintained, good rubber foot pads, no deformities, all parts tight, employee wearing helmet)",
      "required": false,
      "options": []
    },
    {
      "id": "committee-17",
      "kind": "textarea",
      "label": "Scaffolds, Lifts: (Signed off by safety assistant and user daily or tagged out, assembled according to P2 guidelines, wheels locked)",
      "required": false,
      "options": []
    },
    {
      "id": "committee-18",
      "kind": "textarea",
      "label": "Fall Protection: Properly hung and stored, all employees trained and comfortable with equipment on site, floor and wall openings covered legally or barricaded)",
      "required": false,
      "options": []
    },
    {
      "id": "committee-19",
      "kind": "textarea",
      "label": "General attitude on site: (would you like working there)",
