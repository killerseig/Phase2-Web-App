{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "runtime": "nodejs22",
    "predeploy": [
      "npm run build"
    ],
    "ignore": [
      "node_modules",
      ".git"
    ]
  },
  "hosting": {
    "public": "dist",
    "predeploy": [
      "npm run test:shop-order-layout",
      "npm run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://storage.googleapis.com; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://*.firebaseio.com wss://*.firebaseio.com; frame-src 'self' https://*.firebaseapp.com https://www.youtube-nocookie.com https://player.vimeo.com; media-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/website-runtime.html",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "sandbox allow-scripts allow-forms allow-top-navigation-by-user-activation; default-src 'none'; script-src 'self' https://phase2-website.web.app https://phase2-website.firebaseapp.com 'unsafe-inline'; style-src 'self' https://phase2-website.web.app https://phase2-website.firebaseapp.com 'unsafe-inline'; img-src 'self' https://phase2-website.web.app https://phase2-website.firebaseapp.com data: blob:; font-src 'self' https://phase2-website.web.app https://phase2-website.firebaseapp.com data:; connect-src 'none'; frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com; media-src https:; form-action 'none'; base-uri 'none'; frame-ancestors 'self'"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/public-boot.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/public-style.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ],
        "source": "/public-assets/**"
      }
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/employee-app.html"
      },
      {
        "source": "/forms",
        "destination": "/employee-app.html"
      },
      {
        "source": "/form-submissions",
        "destination": "/employee-app.html"
      },
      {
        "source": "/reports",
        "destination": "/employee-app.html"
      },
      {
        "source": "/company-library",
        "destination": "/employee-app.html"
      },
      {
        "source": "/dashboards",
        "destination": "/employee-app.html"
      },
      {
        "source": "/login",
        "destination": "/employee-app.html"
      },
      {
        "source": "/forgot-password",
        "destination": "/employee-app.html"
      },
      {
        "source": "/set-password",
        "destination": "/employee-app.html"
      },
      {
        "source": "/daily-log-gallery",
        "destination": "/employee-app.html"
      },
      {
        "source": "/jobs",
        "destination": "/employee-app.html"
      },
      {
        "source": "/dashboard",
        "destination": "/employee-app.html"
      },
      {
        "source": "/exports",
        "destination": "/employee-app.html"
      },
      {
        "source": "/users",
        "destination": "/employee-app.html"
      },
      {
        "source": "/employees",
        "destination": "/employee-app.html"
      },
      {
        "source": "/settings",
        "destination": "/employee-app.html"
      },
      {
        "source": "/assets",
        "destination": "/employee-app.html"
      },
      {
        "source": "/website-runtime",
        "destination": "/employee-app.html"
      },
      {
        "source": "/public-boot",
        "destination": "/employee-app.html"
      },
      {
        "source": "/public-style",
        "destination": "/employee-app.html"
      },
      {
        "source": "/employee-app",
        "destination": "/employee-app.html"
      },
      {
        "source": "/index",
        "destination": "/employee-app.html"
      },
      {
        "source": "/favicon",
        "destination": "/employee-app.html"
      },
      {
        "source": "/website-image",
        "function": {
          "functionId": "websiteImage",
          "region": "us-central1"
        }
      },
      {
        "source": "/sds-file",
        "function": {
          "functionId": "downloadSdsFile",
          "region": "us-central1"
        }
      },
      {
        "function": {
          "functionId": "getPublishedWebsite",
          "region": "us-central1"
        },
        "source": "/"
      },
      {
        "function": {
          "region": "us-central1",
          "functionId": "getPublishedWebsite"
        },
        "source": "/website/**"
      },
      {
        "function": {
          "functionId": "getPublishedWebsite",
          "region": "us-central1"
        },
        "source": "/*"
      },
      {
        "source": "**",
        "destination": "/employee-app.html"
      }
    ],
    "redirects": [
      {
        "regex": "^/website/?$",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "^/website/home/?$",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "^/website/company/?$",
        "destination": "/company",
        "type": 301
      },
      {
        "regex": "^/website/services/?$",
        "destination": "/services",
        "type": 301
      },
      {
        "regex": "^/website/location/?$",
        "destination": "/location",
        "type": 301
      },
      {
        "regex": "^/website/safety/?$",
        "destination": "/safety",
        "type": 301
      },
      {
        "regex": "^/website/careers/?$",
        "destination": "/careers",
        "type": 301
      },
      {
        "regex": "^/website/insights/?$",
        "destination": "/insights",
        "type": 301
      },
      {
        "regex": "^/website/projects/?$",
        "destination": "/projects",
        "type": 301
      },
      {
        "regex": "^/website/awards/?$",
        "destination": "/awards",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
