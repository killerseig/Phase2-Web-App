rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function userDocExists() {
      return userDoc() != null && userDoc().data != null;
    }

    function userRole() {
      return userDocExists() ? userDoc().data.role : null;
    }

    function hasAdminRole() {
      return userRole() in ['admin', 'Admin'];
    }

    function hasPayrollRole() {
      return userRole() in ['payroll', 'Payroll'];
    }

    function hasShopForemanRole() {
      return userRole() in ['shop-foreman', 'shop_foreman', 'shop foreman', 'shopForeman', 'Shop Foreman'];
    }

    function hasProjectManagerRole() {
      return userRole() in ['project-manager', 'project_manager', 'project manager', 'projectManager', 'Project Manager'];
    }

    function hasForemanRole() {
      return userRole() in ['foreman', 'Foreman'];
    }

    function hasFieldAssigneeRole() {
      return hasForemanRole() || hasShopForemanRole() || hasProjectManagerRole();
    }

    function userIsActive() {
      return userDocExists() && userDoc().data.active != false;
    }

    function roleCanUseApp() {
      return hasAdminRole() ||
             hasPayrollRole() ||
             hasShopForemanRole() ||
             hasForemanRole() ||
             hasProjectManagerRole();
    }

    function activeAppUser() {
      return signedIn() && userDocExists() && userIsActive() && roleCanUseApp();
    }

    function userAssignedJobs() {
      return userDocExists() && userDoc().data.assignedJobIds is list
        ? userDoc().data.assignedJobIds
        : [];
    }

    function jobDoc(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId));
    }

    function foremanAssignedInJobData(jobData) {
      return jobData.assignedForemanIds is list &&
             request.auth.uid in jobData.assignedForemanIds;
    }

    function isShopJobData(jobData) {
      return jobData.code in ['736', 736] ||
             jobData.number in ['736', 736] ||
             jobData.name in ['Shop', 'shop'];
    }

    function isShopJob(jobId) {
      return jobDoc(jobId).data != null && isShopJobData(jobDoc(jobId).data);
    }

    function isAdmin() {
      return signedIn() && userDocExists() && userIsActive() && hasAdminRole();
    }

    function isPayroll() {
      return signedIn() && userDocExists() && userIsActive() && hasPayrollRole();
    }

    function isShopForeman() {
      return signedIn() && userDocExists() && userIsActive() && hasShopForemanRole();
    }

    function isProjectManager() {
      return signedIn() && userDocExists() && userIsActive() && hasProjectManagerRole();
    }

    function isFieldEditorRole() {
      return activeAppUser() && (hasForemanRole() || hasShopForemanRole());
    }

    function canViewAllJobs() {
      return activeAppUser() && (hasAdminRole() || hasPayrollRole() || hasShopForemanRole());
    }

    function canManageEmployees() {
      return isAdmin() || isPayroll();
    }

    function canManageShopCatalog() {
      return isAdmin() || isShopForeman();
    }

    function canUseTimecardExport() {
      return isAdmin() || isPayroll();
    }

    function canUseTimecards() {
      return activeAppUser() && (isAdmin() || isFieldEditorRole());
    }

    function isForemanAssigned(jobId) {
      return activeAppUser() &&
        hasFieldAssigneeRole() &&
        (userAssignedJobs().hasAny([jobId]) ||
         (jobDoc(jobId).data != null && foremanAssignedInJobData(jobDoc(jobId).data)) ||
         (isShopForeman() && isShopJob(jobId)));
    }

    function hasJobReadAccess(jobId) {
      return activeAppUser() && (
        isAdmin() ||
        isForemanAssigned(jobId)
      );
    }

    function hasJobReadAccessFromJobData(jobId, jobData) {
      return activeAppUser() && (
        canViewAllJobs() ||
        (hasFieldAssigneeRole() &&
         (userAssignedJobs().hasAny([jobId]) || foremanAssignedInJobData(jobData)))
      );
    }

    function hasJobWriteAccess(jobId) {
      return activeAppUser() && (
        isAdmin() ||
        (isFieldEditorRole() && isForemanAssigned(jobId))
      );
    }

    function isFieldWorkflowEditorRole() {
      return activeAppUser() && (hasForemanRole() || hasShopForemanRole() || hasProjectManagerRole());
    }

    function hasFieldWorkflowWriteAccess(jobId) {
      return activeAppUser() && (
        isAdmin() ||
        (isFieldWorkflowEditorRole() && isForemanAssigned(jobId))
      );
    }

    function projectManagerCanUpdateJob(jobId) {
      return isProjectManager() &&
             isForemanAssigned(jobId) &&
             !request.resource.data.diff(resource.data).changedKeys().hasAny([
               'active',
               'archivedAt'
             ]);
    }

    function foremanCanWorkWeek(weekData) {
      return canUseTimecards() && hasJobWriteAccess(weekData.jobId);
    }

    function foremanCanReadWeekHeader(weekData) {
      return canUseTimecards() && (hasJobWriteAccess(weekData.jobId) || isForemanAssigned(weekData.jobId));
    }

    function projectManagerCanReadSubmittedWeek(weekData) {
      return isProjectManager() &&
             weekData.status == 'submitted' &&
             isForemanAssigned(weekData.jobId);
    }

    function canReadTimecardWeekHeader(weekData) {
      return activeAppUser() && (
        canUseTimecardExport() ||
        foremanCanWorkWeek(weekData) ||
        foremanCanReadWeekHeader(weekData) ||
        projectManagerCanReadSubmittedWeek(weekData)
      );
    }

    function canReadTimecardWeekCards(weekData) {
      return activeAppUser() && (
        canUseTimecardExport() ||
        foremanCanWorkWeek(weekData) ||
        projectManagerCanReadSubmittedWeek(weekData)
      );
    }

    function canCreateTimecardWeek(weekData) {
      return canUseTimecardExport() ||
             (
               canUseTimecards() &&
               weekData.ownerForemanUserId == request.auth.uid &&
               hasJobWriteAccess(weekData.jobId)
             );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOptionalStringOrNull(value) {
      return value == null || value is string;
    }

    function selfCreateHasValidProfileShape() {
      return request.resource.data.keys().hasOnly([
               'email',
               'displayName',
               'firstName',
               'lastName',
               'role',
               'active',
               'assignedJobIds',
               'createdAt'
             ]) &&
             request.resource.data.role == 'none' &&
             request.resource.data.active == true &&
             request.resource.data.createdAt == request.time &&
             (!('email' in request.resource.data) ||
              isOptionalStringOrNull(request.resource.data.email)) &&
             (!('displayName' in request.resource.data) ||
              isOptionalStringOrNull(request.resource.data.displayName)) &&
             (!('firstName' in request.resource.data) ||
              isOptionalStringOrNull(request.resource.data.firstName)) &&
             (!('lastName' in request.resource.data) ||
              isOptionalStringOrNull(request.resource.data.lastName)) &&
             (!('assignedJobIds' in request.resource.data) ||
              (request.resource.data.assignedJobIds is list &&
               request.resource.data.assignedJobIds.size() == 0));
    }

    function selfUpdateKeepsPrivileges(uid) {
      return isSelf(uid) &&
             request.resource.data.role == resource.data.role &&
             request.resource.data.active == resource.data.active &&
             request.resource.data.assignedJobIds == resource.data.assignedJobIds &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly([
               'firstName',
               'lastName'
             ]) &&
             isOptionalStringOrNull(request.resource.data.firstName) &&
             isOptionalStringOrNull(request.resource.data.lastName);
    }

    function foremanCanUpdateDailyLogRecipients(jobId) {
      return isFieldEditorRole() &&
             isForemanAssigned(jobId) &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly([
               'dailyLogRecipients'
             ]);
    }

    function timecardWeekDoc(weekId) {
      return get(/databases/$(database)/documents/timecardWeeks/$(weekId));
    }

    function timecardWeekExists(weekId) {
      return timecardWeekDoc(weekId).data != null;
    }

    function timecardWeekIsSubmitted(weekId) {
      return timecardWeekExists(weekId) && timecardWeekDoc(weekId).data.status == 'submitted';
    }

    match /users/{uid} {
      allow get: if signedIn() && (isSelf(uid) || isAdmin() || isPayroll());
      allow list: if isAdmin() || isPayroll();
      allow create: if isSelf(uid) && selfCreateHasValidProfileShape();
      allow update: if isAdmin() || selfUpdateKeepsPrivileges(uid);
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if activeAppUser();
      allow create, update, delete: if canManageEmployees();
    }

    match /jobs/{jobId} {
      allow get: if activeAppUser() && (canViewAllJobs() || isForemanAssigned(jobId));
      allow list: if hasJobReadAccessFromJobData(jobId, resource.data);
      allow create: if isAdmin() || isPayroll();
      allow delete: if isAdmin();
      allow update: if isAdmin() ||
                    projectManagerCanUpdateJob(jobId) ||
                    foremanCanUpdateDailyLogRecipients(jobId);
    }

    match /dailyLogs/{logId} {
      allow read: if hasJobReadAccess(resource.data.jobId);
      allow create: if hasFieldWorkflowWriteAccess(request.resource.data.jobId);
      allow update: if isAdmin() ||
                    (hasFieldWorkflowWriteAccess(resource.data.jobId) &&
                     resource.data.status == 'draft' &&
                     request.resource.data.jobId == resource.data.jobId &&
                     request.resource.data.logDate == resource.data.logDate);
      allow delete: if isAdmin() ||
                    (hasFieldWorkflowWriteAccess(resource.data.jobId) &&
                     resource.data.status == 'draft');
    }

    match /timecardWeeks/{weekId} {
      allow get: if canReadTimecardWeekHeader(resource.data);
      allow list: if canReadTimecardWeekHeader(resource.data);
      allow create: if canCreateTimecardWeek(request.resource.data);
      allow update: if isAdmin() ||
                    (canUseTimecards() &&
                     resource.data.status == 'draft' &&
                     hasJobWriteAccess(resource.data.jobId) &&
                     request.resource.data.diff(resource.data).changedKeys().hasOnly([
                       'status',
                       'employeeCardCount',
                       'submittedAt',
                       'updatedAt',
                       'updatedByUserId',
                       'submittedByUserId',
                       'submittedByName'
                     ]));
      allow delete: if isAdmin() ||
                    (isPayroll() && resource.data.status == 'draft') ||
                    (canUseTimecards() &&
                     resource.data.status == 'draft' &&
                     resource.data.ownerForemanUserId == request.auth.uid);

      match /cards/{cardId} {
        allow read: if timecardWeekExists(weekId) &&
                       canReadTimecardWeekCards(timecardWeekDoc(weekId).data);
        allow create: if timecardWeekExists(weekId) &&
                       (canUseTimecardExport() ||
                        (canUseTimecards() && hasJobWriteAccess(timecardWeekDoc(weekId).data.jobId))) &&
                       (!timecardWeekIsSubmitted(weekId) || canUseTimecardExport());
        allow update, delete: if timecardWeekExists(weekId) &&
                              (canUseTimecardExport() ||
                               (canUseTimecards() && hasJobWriteAccess(timecardWeekDoc(weekId).data.jobId))) &&
                              (!timecardWeekIsSubmitted(weekId) || canUseTimecardExport());
      }
    }

    match /shopCatalog/{itemId} {
      allow read: if activeAppUser();
      allow create, update, delete: if canManageShopCatalog();
    }

    match /shopCategories/{categoryId} {
      allow read: if activeAppUser();
      allow create, update, delete: if canManageShopCatalog();
    }

    match /shopOrders/{orderId} {
      allow read: if hasJobReadAccess(resource.data.jobId);
      allow create: if hasFieldWorkflowWriteAccess(request.resource.data.jobId);
      allow update: if isAdmin() ||
                    (hasFieldWorkflowWriteAccess(resource.data.jobId) &&
                     resource.data.status == 'draft' &&
                     request.resource.data.jobId == resource.data.jobId);
      allow delete: if isAdmin() ||
                    (hasFieldWorkflowWriteAccess(resource.data.jobId) &&
                     resource.data.status == 'draft');
    }

    match /settings/{settingId} {
      allow read: if activeAppUser();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
