rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function requestHasDailyLogAttachmentMetadata(logId) {
      return request.resource.metadata != null &&
             'jobId' in request.resource.metadata &&
             'dailyLogId' in request.resource.metadata &&
             'uploadedBy' in request.resource.metadata &&
             request.resource.metadata.dailyLogId == logId &&
             request.resource.metadata.uploadedBy == request.auth.uid;
    }

    function isSupportedDailyLogAttachmentUpload(logId) {
      return request.resource != null &&
             resource == null &&
             request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*') &&
             request.resource.metadata.variant == 'gallery-photo' &&
             requestHasDailyLogAttachmentMetadata(logId);
    }

    function isSupportedDailyLogThumbnailUpload(logId) {
      return request.resource != null &&
             resource == null &&
             request.resource.size <= 300 * 1024 &&
             request.resource.contentType == 'image/jpeg' &&
             request.resource.metadata.variant == 'email-thumbnail' &&
             requestHasDailyLogAttachmentMetadata(logId);
    }

    match /daily-logs/{logId}/thumbnails/{fileName} {
      // Download tokens are intentionally used for the public gallery. Authenticated app reads
      // remain available here for field workflows and cleanup.
      allow read: if signedIn();
      allow create: if signedIn() && isSupportedDailyLogThumbnailUpload(logId);
      allow delete: if signedIn();
      allow update: if false;
    }

    match /daily-logs/{logId}/{fileName} {
      // Firestore and callable functions authorize access to the parent daily log.
      // Keeping object rules self-contained avoids a separate cross-product IAM
      // dependency that can reject valid field users before an upload begins.
      allow read: if signedIn();
      allow create: if signedIn() && isSupportedDailyLogAttachmentUpload(logId);
      allow delete: if signedIn();
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
