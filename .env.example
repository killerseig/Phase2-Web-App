# Public Firebase web app configuration. Supply your own values in .env.local.
# Never put service-account keys, OAuth secrets or mail-provider secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Independent public marketing and employee feature-usage destinations.
# Two distinct GA4 PROPERTIES must be confirmed; different streams in one property do not suffice.
# Approval includes notice/privacy review and automatic/enhanced measurement disabled in each stream.
# Collection remains off until enabled + approved + valid distinct ID + exact HTTPS host + visit consent.
VITE_PUBLIC_ANALYTICS_ENABLED=false
VITE_PUBLIC_ANALYTICS_APPROVED=false
VITE_PUBLIC_GA4_MEASUREMENT_ID=
VITE_PUBLIC_ANALYTICS_HOSTS=
VITE_EMPLOYEE_ANALYTICS_ENABLED=false
VITE_EMPLOYEE_ANALYTICS_APPROVED=false
VITE_EMPLOYEE_GA4_MEASUREMENT_ID=
VITE_EMPLOYEE_ANALYTICS_HOSTS=
